{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "build": {
    "env": {
      "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1"
    }
  },
  "functions": {
    "app/main.py": {
      "maxDuration": 60,
      "excludeFiles": "{train.py,test.py,mydatasets.py,losses.py,outputs/**,models/best_multi_evidence_stage1.pth,models/MPC_CATNet_stage2_weights.pth,models/mpc_stage1_best.pth}"
    },
    "main.py": {
      "maxDuration": 60,
      "excludeFiles": "{train.py,test.py,mydatasets.py,losses.py,outputs/**,models/best_multi_evidence_stage1.pth,models/MPC_CATNet_stage2_weights.pth,models/mpc_stage1_best.pth}"
    }
  }
}
