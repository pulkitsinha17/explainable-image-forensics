# =============================================================
# PIXENTRA Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# =============================================================

# ── Application URL (Optional for SSR / Share Links) ─────────
# In development: http://localhost:3000
# In production: https://your-production-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Clerk Authentication ──────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ── MongoDB ───────────────────────────────────────────────────
MONGODB_URI=

# ── AWS S3 (server-side only — NEVER use NEXT_PUBLIC_ prefix) ─
# Region where your S3 bucket lives
AWS_REGION=ap-south-1

# IAM user: pixentra-backend (policy: PIXENTRA-S3-Image-Access)
# Get these from AWS IAM → Users → pixentra-backend → Security credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Private S3 bucket name (already created)
AWS_S3_BUCKET_NAME=pixentra-image-storage-2026

# ── ML Backend (FastAPI) ──────────────────────────────────────
# URL of the Python ML inference service (run from ml_backend/).
# In development: python ml_backend/run.py  (starts on port 8001)
ML_BACKEND_URL=http://localhost:8001

# Shared secret for Next.js → FastAPI inter-service authentication.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Set the SAME value in the FastAPI process as PIXENTRA_INTERNAL_SECRET.
# Leave empty in development to disable (NOT recommended for production).
ML_BACKEND_SECRET=
