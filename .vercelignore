# Vercel deployment ignore rules
# Exclude caches, test outputs, training scripts, and unused checkpoints

# Node and Next.js caches
node_modules/
.next/

# Python virtual environment and caches
.venv/
ml_backend/.venv/
**/__pycache__/
**/*.pyc
**/*.pyo

# ML backend training, testing, and output artifacts
ml_backend/train.py
ml_backend/test.py
ml_backend/mydatasets.py
ml_backend/losses.py
ml_backend/outputs/
ml_backend/*.ipynb

# Unused checkpoints (ONLY active production models preserved)
